# Backend Configuration
FLASK_ENV=development
DEBUG=True

# Database
DATABASE_URL=postgresql://victor:victor_password@postgres:5432/victor_db
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=victor
DATABASE_PASSWORD=victor_password
DATABASE_NAME=victor_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=True

# WebSocket Configuration
WS_HOST=0.0.0.0
WS_PORT=8000
WS_POOL_SIZE=100

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Redis (for caching and real-time data)
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/victor.log

# AI Configuration
MODEL_CACHE_DIR=./models
BACKTEST_CACHE_DIR=./backtest_cache

# Market Data Update Interval (seconds)
UPDATE_INTERVAL=1
CHART_CACHE_DURATION=300

# Application
APP_NAME=VICTOR Trading
APP_VERSION=0.1.0
